SCRIBER_DOMAIN=app.usescriber.com
SCRIBER_ACCESS_PASSWORD=replace-me
SCRIBER_AUTH_SECRET=replace-me
SCRIBER_INTERNAL_API_TOKEN=replace-me

OPENAI_API_KEY=sk-replace-me
LINEAR_API_KEY=lin_api_replace_me
LINEAR_TEAM_KEY=BEN

GOOGLE_CALENDAR_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=replace-me
GOOGLE_CALENDAR_REDIRECT_URI=https://app.usescriber.com/api/calendar/google/callback

SCRIBER_WORKER_POLL_MS=15000
SCRIBER_WORKER_LAUNCH_STAGED=true
SCRIBER_MEET_HEADLESS=true
SCRIBER_AUDIO_SAMPLE_RATE=24000

# Example Linux commands once virtual audio is configured.
# SCRIBER_AUDIO_CAPTURE_COMMAND=ffmpeg -f pulse -i default.monitor -ac 1 -ar 24000 -f s16le -
# SCRIBER_AUDIO_PLAYBACK_COMMAND=ffplay -nodisp -autoexit -f s16le -ar 24000 -ac 1 -

# Zoom adapter boundary is present; native SDK credentials are required before it can join real Zoom calls.
ZOOM_MEETING_SDK_KEY=
ZOOM_MEETING_SDK_SECRET=
