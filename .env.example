# Scriber + Mnemo — environment template
# Copy to .env.local and fill values.

# OpenAI — used for both Realtime sessions (Scriber + Mnemo) and gpt-image-1
OPENAI_API_KEY=sk-proj-...

# Linear — BenIkigai workspace (or any Linear workspace)
LINEAR_API_KEY=lin_api_...

# Slack — optional incoming webhook for end-of-standup recap
# If unset, Scriber falls back to verbal recap only
SLACK_WEBHOOK_URL=

# Mnemo sidecar — WS port for whisper bus
MNEMO_PORT=3100
